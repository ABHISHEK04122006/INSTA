# Backend API base URL (optional in dev if proxying via Vite; required in production when hosted separately)
# Example: https://nexora-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket server URL (optional, defaults to VITE_API_URL host or origin)
# Example: https://nexora-api.onrender.com
VITE_SOCKET_URL=http://localhost:5000
