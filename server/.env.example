# MongoDB connection URI (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/insta?retryWrites=true&w=majority

# JWT secret key for signing auth tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend origin URL for CORS (comma-separated if multiple, e.g. https://your-site.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Port the server listens on
PORT=5000

# Cloudinary credentials for media (photos, videos, avatars, reels)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email credentials (for password reset OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SECURE=false
MAIL_FROM="Nexora <your_email@gmail.com>"
